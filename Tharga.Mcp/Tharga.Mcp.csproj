<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Authors>Daniel Bohlin</Authors>
		<Company>Thargelion AB</Company>
		<Product>Tharga Mcp</Product>
		<Description>Foundation package for MCP (Model Context Protocol) infrastructure in the Tharga ecosystem. Provides contracts, registration, and transport for Tharga provider packages and applications.</Description>
		<PackageIconUrl>https://thargelion.net/assets/component-mcp.png</PackageIconUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/Tharga/Mcp</PackageProjectUrl>
		<DebugType>portable</DebugType>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSource>true</IncludeSource>
		<IncludeSymbols>true</IncludeSymbols>
	</PropertyGroup>
	<PropertyGroup>
		<!--
			NU5048: PackageIconUrl is deprecated in favour of an embedded PackageIcon.
			Suppressed deliberately. Tharga packages reference their icon from
			https://thargelion.net/assets/ so all package icons are maintained in one
			place and can be updated without republishing a package.
		-->
		<NoWarn>1701;1702;CS1591;CS0809;NU5048</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ModelContextProtocol" Version="1.4.1" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Tharga.Mcp.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
</Project>
